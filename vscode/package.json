{
  "name": "apidoc-vscode",
  "displayName": "apiDoc (Tyba)",
  "description": "Completion, syntax highlighting and snippets for @tyba-co/apidoc comments (@api, @apiParam, ...), and a JSON schema for apidoc.json",
  "version": "0.2.2",
  "publisher": "tyba-co",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#253138",
    "theme": "dark"
  },
  "homepage": "https://tyba-co.github.io/apidoc/",
  "bugs": {
    "url": "https://github.com/tyba-co/apidoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tyba-co/apidoc",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "apidoc",
    "api",
    "documentation",
    "rest",
    "snippets",
    "autocomplete",
    "completion"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:php",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:dart",
    "onLanguage:groovy",
    "onLanguage:kotlin",
    "onLanguage:scala",
    "onLanguage:python",
    "onLanguage:ruby",
    "onLanguage:perl",
    "onLanguage:lua",
    "onLanguage:coffeescript",
    "onLanguage:elixir",
    "onLanguage:erlang",
    "onLanguage:clojure"
  ],
  "scripts": {
    "package": "npx --yes @vscode/vsce@3.9.2 package --no-dependencies",
    "test:host": "node test/run.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.2"
  },
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/tags.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/tags.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/tags.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/tags.json"
      },
      {
        "language": "php",
        "path": "./snippets/tags.json"
      },
      {
        "language": "java",
        "path": "./snippets/tags.json"
      },
      {
        "language": "go",
        "path": "./snippets/tags.json"
      },
      {
        "language": "c",
        "path": "./snippets/tags.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/tags.json"
      },
      {
        "language": "csharp",
        "path": "./snippets/tags.json"
      },
      {
        "language": "dart",
        "path": "./snippets/tags.json"
      },
      {
        "language": "groovy",
        "path": "./snippets/tags.json"
      },
      {
        "language": "python",
        "path": "./snippets/tags.json"
      },
      {
        "language": "ruby",
        "path": "./snippets/tags.json"
      },
      {
        "language": "perl",
        "path": "./snippets/tags.json"
      },
      {
        "language": "lua",
        "path": "./snippets/tags.json"
      },
      {
        "language": "coffeescript",
        "path": "./snippets/tags.json"
      },
      {
        "language": "clojure",
        "path": "./snippets/tags.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "php",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "java",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "go",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "c",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "csharp",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "dart",
        "path": "./snippets/blocks.json"
      },
      {
        "language": "groovy",
        "path": "./snippets/blocks.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "apidoc.json"
        ],
        "url": "./schemas/apidoc.schema.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "apidoc.injection",
        "path": "./syntaxes/apidoc.injection.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx",
          "source.vue",
          "source.php",
          "source.java",
          "source.go",
          "source.c",
          "source.cpp",
          "source.cs",
          "source.dart",
          "source.groovy",
          "source.kotlin",
          "source.scala",
          "source.python",
          "source.ruby",
          "source.perl",
          "source.lua",
          "source.coffee",
          "source.elixir",
          "source.erlang",
          "source.clojure"
        ]
      }
    ]
  }
}
